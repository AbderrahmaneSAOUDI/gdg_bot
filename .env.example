# Discord Bot Application Credentials
# Obtain these from the Discord Developer Portal: https://discord.com/developers/applications

# The bot token (Bot tab -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# The application / client ID (General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Optional: Specific Discord Server (Guild) ID for instant slash command registration during development
# If left empty, commands will be deployed globally (which can take up to 1 hour to propagate)
GUILD_ID=your_guild_id_here

# Optional: Specific channel ID where the bot sends a greeting ("hi") on startup
# If left empty, the bot automatically selects the first available text channel in the guild
STARTUP_CHANNEL_ID=

# Phase 2 role bindings are configured per guild in /bot -> Check Setup -> Bind Roles.
# Names alone never grant management authority. Bind leadership and department
# membership IDs separately; Dev is not Dev Department. Configure CORE for channels.
# No additional token, cloud database, calendar, or external-service secret is required.

