# Discord Bot Application Credentials
# Obtain these from the Discord Developer Portal: https://discord.com/developers/applications

# The bot token (Bot tab -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# The application / client ID (General Information -> Application ID)
CLIENT_ID=your_client_id_here

# Optional: Specific Discord Server (Guild) ID for instant slash command registration during development
# If left empty, commands will be deployed globally (which can take up to 1 hour to propagate)
GUILD_ID=your_guild_id_here
